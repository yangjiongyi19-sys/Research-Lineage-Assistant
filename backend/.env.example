# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# =============================================================================
# LLM 提供商配置
# =============================================================================

# 选择 LLM 提供商: openai 或 bailian (阿里百炼)
LLM_PROVIDER=openai

# --- OpenAI 配置 ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- 阿里百炼配置 (通义千问) ---
# 从 https://bailian.console.aliyun.com/ 获取 API Key
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选模型: qwen-turbo(快/便宜), qwen-plus(均衡), qwen-max(强)
BAILIAN_MODEL=qwen-turbo

# =============================================================================
# 搜索配置 (Exa Search MCP)
# =============================================================================
# Exa MCP 是远程托管服务，无需 API Key 即可使用基础搜索功能
# 免费额度: 3 QPS, 150 calls/day
# 可选：传入 API Key 以解锁高级功能和更高限额

# Exa API Key (可选，留空使用免费额度)
EXA_API_KEY=

# Exa MCP 服务端点 (默认无需修改)
EXA_MCP_URL=https://mcp.exa.ai/mcp

# =============================================================================
# 数据库配置
# =============================================================================

# 数据库连接 (可选，默认使用 SQLite)
DATABASE_URL=sqlite+aiosqlite:///./research.db

# =============================================================================
# 应用配置
# =============================================================================

DEBUG=false
MAX_ITERATIONS=3
SEARCH_RESULTS_LIMIT=5